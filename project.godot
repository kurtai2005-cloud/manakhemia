; Engine configuration file.
; Godot 4.7 G0 — 微光小圃
config_version=5

[application]
config/name="微光小圃"
config/name_localized={"zh_HK": "微光小圃", "zh_TW": "微光小圃"}
config/description="Godot 4 port M1b"
config/version="2.0.0-m1b"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]
GameData="*res://scripts/autoload/GameData.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
TimeService="*res://scripts/autoload/TimeService.gd"
Sim="*res://scripts/autoload/Sim.gd"
QualitySettings="*res://scripts/autoload/QualitySettings.gd"
ArtImporter="*res://scripts/autoload/ArtImporter.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
Personality="*res://scripts/autoload/Personality.gd"
IconBank="*res://scripts/autoload/IconBank.gd"
HuntSystem="*res://scripts/autoload/HuntSystem.gd"
WorkSystem="*res://scripts/autoload/WorkSystem.gd"
CollectionSystem="*res://scripts/autoload/CollectionSystem.gd"
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filter_level=2
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
environment/defaults/default_clear_color=Color(0.529, 0.741, 0.878, 1)

[android]
package/unique_name="hk.vizard.glimmer.fpet.godot"

[debug]
gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unused_variable=1
gdscript/warnings/unused_local_constant=1
gdscript/warnings/unused_private_class_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/unused_signal=1

[editor_plugins]
enabled=PackedStringArray("res://addons/beehave/plugin.cfg")
